{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "NEXUS Aether Design Tokens",
  "version": "1.0.0",
  "radii": {
    "small": 10,
    "medium": 14,
    "large": 20,
    "xl": 24,
    "xxl": 28,
    "pill": 9999
  },
  "spacing": {
    "space-1": 2,
    "space-2": 4,
    "space-3": 8,
    "space-4": 12,
    "space-5": 16,
    "space-6": 20,
    "space-7": 24,
    "space-8": 32,
    "space-9": 40,
    "space-10": 48,
    "space-12": 64
  },
  "typography": {
    "fonts": {
      "ui": "'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace"
    },
    "hierarchy": {
      "display": { "size": 28, "lineHeight": 36, "weight": 600 },
      "h1": { "size": 22, "lineHeight": 28, "weight": 600 },
      "h2": { "size": 18, "lineHeight": 24, "weight": 600 },
      "h3": { "size": 15, "lineHeight": 20, "weight": 600 },
      "h4": { "size": 14, "lineHeight": 18, "weight": 600 },
      "bodyLarge": { "size": 15, "lineHeight": 22, "weight": 400 },
      "body": { "size": 13, "lineHeight": 18, "weight": 400 },
      "bodySmall": { "size": 12, "lineHeight": 16, "weight": 400 },
      "caption": { "size": 11, "lineHeight": 14, "weight": 500 },
      "code": { "size": 12, "lineHeight": 18, "weight": 400 }
    }
  },
  "motion": {
    "durationFast": 120,
    "durationNormal": 180,
    "durationSlow": 280,
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "reducedMotionDuration": 0
  },
  "accents": {
    "indigo": "#6366F1",
    "emerald": "#10B981",
    "amber": "#F59E0B",
    "crimson": "#EF4444",
    "cyan": "#06B6D4",
    "violet": "#8B5CF6",
    "rose": "#F43F5E",
    "sky": "#0284C7"
  }
}
