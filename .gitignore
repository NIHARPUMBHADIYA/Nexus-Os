# =============================================================================
# NEXUS OS — Git Ignore Configuration
# =============================================================================

# Large binary OS images & ISO artifacts (must not be committed to Git)
build/*.iso
build/*.iso.sha256
build/cache/
build/tmp/
build/iso/
*.iso
*.img
*.vdi
*.vbox*
*.webm
*.nvram

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Rust / Cargo
**/target/
Cargo.lock

# C++ / Qt / CMake
build*/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib

# IDE & Editor
.vscode/
.idea/
*.swp
*~

# OS generated
Thumbs.db
Desktop.ini
.DS_Store
