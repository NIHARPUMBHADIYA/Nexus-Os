# =============================================================================
# NEXUS OS — Cloud-Native Bootable Container (bootc) Image Specification
# Target Base: Fedora 41 x86_64 (KDE Plasma 6, Wayland, PipeWire, bootc)
# =============================================================================

FROM quay.io/fedora/fedora-bootc:41

LABEL maintainer="NEXUS OS Systems Architecture Team <team@nexus-os.org>"
LABEL description="NEXUS OS Developer-First AI-Native Operating System"
LABEL version="2026.1"

# 1. System Repositories and GPG Keys
RUN dnf -y install 'dnf5-plugins' && \
    dnf config-manager addrepo --from-repofile=https://dl.fedoraproject.org/pub/fedora/linux/releases/41/Everything/x86_64/os/ || true

# 2. Base Desktop & Display Infrastructure (KDE Plasma 6 Wayland)
RUN dnf -y install \
    @kde-desktop \
    plasma-workspace-wayland \
    kwin-wayland \
    sddm-kcm \
    qt6-qtbase \
    qt6-qtdeclarative \
    qt6-qtquickcontrols2 \
    pipewire \
    wireplumber \
    pipewire-pulseaudio \
    pipewire-alsa \
    NetworkManager \
    NetworkManager-wifi \
    bluez \
    bluez-tools \
    polkit \
    flatpak \
    && dnf clean all

# 3. Core Developer Toolchain & Containers
RUN dnf -y install \
    podman \
    podman-docker \
    buildah \
    skopeo \
    git \
    git-lfs \
    gh \
    curl \
    wget \
    zsh \
    fastfetch \
    htop \
    btop \
    neovim \
    sqlite \
    sqlite-devel \
    gcc \
    gcc-c++ \
    make \
    cmake \
    ninja-build \
    python3 \
    python3-devel \
    python3-pip \
    rust \
    cargo \
    && dnf clean all

# 4. Create Default Live User & Configure Privileges
RUN useradd -m -u 1000 -G wheel -s /bin/bash nexus && \
    echo "nexus:nexus" | chpasswd && \
    echo "nexus ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/nexus && \
    chmod 0440 /etc/sudoers.d/nexus

# 5. Copy NEXUS OS Core Binaries, QML Shell & Configurations
RUN mkdir -p /usr/libexec/nexus /usr/share/nexus /etc/nexus /etc/skel/.config/nexus

COPY src/ /usr/share/nexus/src/
COPY packaging/systemd/ /etc/systemd/system/
COPY packaging/polkit/50-nexus-developer.rules /etc/polkit-1/rules.d/50-nexus-developer.rules

# 6. Configure SDDM Display Manager & Aether Session with Autologin
RUN mkdir -p /etc/sddm.conf.d && \
    echo -e "[Theme]\nCurrent=breeze\n\n[General]\nInputMethod=\nNumlock=none\nDisplayServer=wayland\n\n[Autologin]\nUser=nexus\nSession=plasmawayland\n" > /etc/sddm.conf.d/nexus_theme.conf

# 7. Configure Zero Telemetry & Privacy Enforcements
RUN mkdir -p /etc/nexus && \
    echo '{"privacy.telemetry_enabled": false, "security.loopback_only": true}' > /etc/nexus/system_policy.json

# 8. Enable Essential Systemd Daemons
RUN systemctl enable sddm.service && \
    systemctl enable NetworkManager.service && \
    systemctl enable bluetooth.service && \
    systemctl enable podman.socket

# 9. First-Boot Provisioning Service
COPY packaging/scripts/nexus-firstboot.sh /usr/libexec/nexus/nexus-firstboot.sh
RUN chmod 0755 /usr/libexec/nexus/nexus-firstboot.sh && \
    systemctl enable nexus-firstboot.service || true

# 10. Clean caches and prepare container image for bootc kernel assembly
RUN dnf clean all && rm -rf /var/cache/dnf /tmp/* /var/tmp/*
