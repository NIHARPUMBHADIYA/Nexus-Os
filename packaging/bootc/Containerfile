# =============================================================================
# NEXUS OS — Cloud-Native Bootable Container (bootc) Image Specification
# Target Base: Fedora 41 x86_64 (KDE Plasma 6, Wayland, PipeWire, bootc)
# =============================================================================

FROM quay.io/fedora/fedora-bootc:41

LABEL maintainer="NEXUS OS Systems Architecture Team <team@nexus-os.org>"
LABEL description="NEXUS OS Developer-First AI-Native Operating System"
LABEL version="2026.1"

# 1. System Repositories and GPG Keys
RUN dnf -y install 'dnf5-plugins' && \
    dnf config-manager addrepo --from-repofile=https://dl.fedoraproject.org/pub/archive/fedora/linux/releases/41/Everything/x86_64/os/ || true

# 2. Base Desktop & Display Infrastructure (KDE Plasma 6 Wayland)
RUN dnf -y install \
    @kde-desktop \
    plasma-workspace-wayland \
    kwin-wayland \
    sddm-kcm \
    qt6-qtbase \
    qt6-qtdeclarative \
    qt6-qtquickcontrols2 \
    qt6-qtsvg \
    python3-pyqt6 \
    python3-pyqt6-sip \
    initial-setup \
    initial-setup-gui \
    initial-setup-gui-wayland-plasma \
    pipewire \
    wireplumber \
    pipewire-pulseaudio \
    pipewire-alsa \
    NetworkManager \
    NetworkManager-wifi \
    bluez \
    bluez-tools \
    polkit \
    flatpak \
    && dnf clean all

# 3. Core Developer Toolchain & Containers
RUN dnf -y install \
    podman \
    podman-docker \
    buildah \
    skopeo \
    git \
    git-lfs \
    gh \
    curl \
    wget \
    zsh \
    fastfetch \
    htop \
    btop \
    neovim \
    sqlite \
    sqlite-devel \
    gcc \
    gcc-c++ \
    make \
    cmake \
    ninja-build \
    python3 \
    python3-devel \
    python3-pip \
    rust \
    cargo \
    && dnf clean all

# 4. Configure Administrator Privileges & First-Boot Account Setup Trigger
RUN echo "%wheel ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/wheel && \
    chmod 0440 /etc/sudoers.d/wheel && \
    touch /etc/reconfigSys

# 5. Copy NEXUS OS Core Binaries, QML Shell & Configurations
RUN mkdir -p /usr/libexec/nexus /usr/share/nexus /etc/nexus /etc/skel/.config/nexus /etc/xdg/autostart

COPY src/ /usr/share/nexus/src/
COPY tools/ /usr/share/nexus/tools/
COPY packaging/systemd/ /etc/systemd/system/
COPY packaging/polkit/50-nexus-developer.rules /etc/polkit-1/rules.d/50-nexus-developer.rules
COPY packaging/autostart/ /etc/xdg/autostart/

RUN chmod +x /usr/share/nexus/tools/*.py && \
    ln -sf /usr/share/nexus/tools/run_desktop.py /usr/bin/nexus-desktop && \
    ln -sf /usr/share/nexus/tools/run_setup.py /usr/bin/nexus-setup && \
    ln -sf /usr/share/nexus/tools/run_settings.py /usr/bin/nexus-settings && \
    ln -sf /usr/share/nexus/tools/run_spotlight.py /usr/bin/nexus-spotlight

# 6. Configure SDDM Display Manager & Wayland Session
RUN mkdir -p /etc/sddm.conf.d /usr/share/wayland-sessions && \
    printf "[Theme]\nCurrent=breeze\n\n[General]\nInputMethod=\nNumlock=none\nDisplayServer=wayland\n\n[Autologin]\nSession=plasma\nRelogin=false\n" > /etc/sddm.conf.d/nexus_theme.conf && \
    ln -sf /usr/share/wayland-sessions/plasma.desktop /usr/share/wayland-sessions/plasmawayland.desktop 2>/dev/null || true && \
    ln -sf /usr/share/wayland-sessions/plasma.desktop /usr/share/wayland-sessions/nexus.desktop 2>/dev/null || true

# 7. Configure Zero Telemetry & Privacy Enforcements
RUN mkdir -p /etc/nexus && \
    echo '{"privacy.telemetry_enabled": false, "security.loopback_only": true}' > /etc/nexus/system_policy.json

# 8. Enable Essential Systemd Daemons & Initial Setup
RUN systemctl enable sddm.service && \
    systemctl enable NetworkManager.service && \
    systemctl enable bluetooth.service && \
    systemctl enable podman.socket && \
    systemctl enable initial-setup.service && \
    systemctl enable initial-setup-graphical.service

# 9. First-Boot Provisioning Service
COPY packaging/scripts/nexus-firstboot.sh /usr/libexec/nexus/nexus-firstboot.sh
RUN chmod 0755 /usr/libexec/nexus/nexus-firstboot.sh && \
    systemctl enable nexus-firstboot.service || true

# 10. Install Live Boot Tools & Generate Contract-Compliant Initramfs
RUN dnf -y install \
    dracut-live \
    dracut-squash \
    squashfs-tools \
    grub2-efi-x64 \
    grub2-pc \
    grub2-pc-modules \
    shim-x64 \
    efibootmgr \
    && dnf clean all

RUN KVER=$(ls /usr/lib/modules | head -n1) && \
    echo "Configuring kernel ${KVER} for bootc ISO contract..." && \
    if [ ! -f "/usr/lib/modules/${KVER}/vmlinuz" ] && [ -f "/boot/vmlinuz-${KVER}" ]; then \
      cp "/boot/vmlinuz-${KVER}" "/usr/lib/modules/${KVER}/vmlinuz"; \
    fi && \
    dracut --verbose --kver "${KVER}" --force --add "dmsquash-live squash" "/usr/lib/modules/${KVER}/initramfs.img"

# 11. Clean caches and prepare container image for bootc kernel assembly
RUN dnf clean all && rm -rf /var/cache/dnf /tmp/* /var/tmp/*
